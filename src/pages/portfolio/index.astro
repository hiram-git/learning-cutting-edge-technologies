---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';

const skills = [
  // Legendary
  { name: 'TypeScript', level: 92, rarity: 'legendary', icon: '⚡' },
  { name: 'React',      level: 90, rarity: 'legendary', icon: '⚛️' },
  // Epic
  { name: 'Node.js',   level: 85, rarity: 'epic',      icon: '🟢' },
  { name: 'Astro',     level: 82, rarity: 'epic',      icon: '🚀' },
  // Rare
  { name: 'PostgreSQL',level: 75, rarity: 'rare',      icon: '🗄️' },
  { name: 'Docker',    level: 70, rarity: 'rare',      icon: '🐳' },
  // Uncommon
  { name: 'Python',    level: 65, rarity: 'uncommon',  icon: '🐍' },
  { name: 'Git',       level: 88, rarity: 'uncommon',  icon: '🌿' },
];

const rarityConfig = {
  legendary: { label: 'LEGENDARY', color: '#f5a623', glow: 'rgba(245,166,35,0.6)' },
  epic:      { label: 'EPIC',      color: '#9b59ff', glow: 'rgba(155,89,255,0.6)' },
  rare:      { label: 'RARE',      color: '#00c8ff', glow: 'rgba(0,200,255,0.6)'  },
  uncommon:  { label: 'UNCOMMON',  color: '#00e676', glow: 'rgba(0,230,118,0.6)'  },
};

const projects = [
  {
    id: '01',
    name: 'Admin Portal Pro',
    desc: 'Panel administrativo full-stack con autenticación, roles y permisos. SSR con Astro + PostgreSQL.',
    tags: ['Astro', 'TypeScript', 'PostgreSQL', 'Drizzle'],
    status: 'DEPLOYED',
    xp: 2500,
  },
  {
    id: '02',
    name: 'E-Commerce Engine',
    desc: 'Plataforma de ventas con carrito, pagos y dashboard en tiempo real. API REST con Node.js.',
    tags: ['React', 'Node.js', 'MongoDB', 'Stripe'],
    status: 'COMPLETED',
    xp: 3200,
  },
  {
    id: '03',
    name: 'Real-Time Chat',
    desc: 'Aplicación de mensajería instantánea con salas y notificaciones push usando WebSockets.',
    tags: ['Socket.io', 'React', 'Redis', 'Docker'],
    status: 'IN PROGRESS',
    xp: 1800,
  },
];
---

<PortfolioLayout title="Dev Portfolio | Fortnite Edition">

  <!-- ═══════════════════════════════ NAVBAR ═══════════════════════════════ -->
  <nav class="fn-nav">
    <div class="fn-nav__logo">
      <span class="fn-nav__logo-bracket">[</span>
      DEV
      <span class="fn-nav__logo-bracket">]</span>
    </div>
    <ul class="fn-nav__links">
      <li><a href="#hero">HOME</a></li>
      <li><a href="#skills">ARSENAL</a></li>
      <li><a href="#projects">MISSIONS</a></li>
      <li><a href="#contact">DEPLOY</a></li>
    </ul>
    <div class="fn-nav__status">
      <span class="fn-nav__dot"></span>
      ONLINE
    </div>
  </nav>

  <!-- ═══════════════════════════════ HERO ════════════════════════════════ -->
  <section id="hero" class="hero">
    <canvas id="particleCanvas" class="hero__canvas"></canvas>

    <!-- Background grid -->
    <div class="hero__grid" aria-hidden="true"></div>

    <!-- Corner HUD elements -->
    <div class="hud hud--tl" aria-hidden="true">
      <div class="hud__label">SEASON 01</div>
      <div class="hud__value">BATTLE PASS</div>
    </div>
    <div class="hud hud--tr" aria-hidden="true">
      <div class="hud__label">XP</div>
      <div class="hud__value hud__xp">84,200</div>
    </div>
    <div class="hud hud--bl" aria-hidden="true">
      <div class="hud__label">RANK</div>
      <div class="hud__value">CHAMPION</div>
    </div>
    <div class="hud hud--br" aria-hidden="true">
      <div class="hud__label">PLAYER</div>
      <div class="hud__value">TU_NOMBRE</div>
    </div>

    <!-- Hero content -->
    <div class="hero__content">
      <p class="hero__eyebrow">// FULL STACK DEVELOPER</p>
      <h1 class="hero__title">
        <span class="hero__title-line hero__title-line--1">HOLA,</span>
        <span class="hero__title-line hero__title-line--2">SOY <em>TU NOMBRE</em></span>
      </h1>
      <p class="hero__subtitle">
        Construyo experiencias digitales de alto impacto con tecnología de punta.
        <span class="hero__cursor" aria-hidden="true">|</span>
      </p>

      <!-- Level bar -->
      <div class="hero__level">
        <span class="hero__level-label">LVL 99</span>
        <div class="hero__level-bar">
          <div class="hero__level-fill"></div>
        </div>
        <span class="hero__level-label">MAX</span>
      </div>

      <div class="hero__actions">
        <a href="#projects" class="btn-fn btn-fn-primary">VER MISIONES</a>
        <a href="#contact"  class="btn-fn btn-fn-secondary">CONTACTAR</a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator" aria-hidden="true">
      <div class="scroll-indicator__line"></div>
      <span>SCROLL</span>
    </div>
  </section>

  <!-- ══════════════════════════════ SKILLS ════════════════════════════════ -->
  <section id="skills" class="section skills">
    <div class="section__header reveal">
      <p class="section-eyebrow">// INVENTARIO DE HABILIDADES</p>
      <h2 class="section-title">ARSENAL <span>TECNOLÓGICO</span></h2>
    </div>

    <div class="skills__grid">
      {skills.map((skill, i) => {
        const cfg = rarityConfig[skill.rarity as keyof typeof rarityConfig];
        return (
          <div
            class="skill-card reveal"
            style={`--rarity-color:${cfg.color}; --rarity-glow:${cfg.glow}; --skill-level:${skill.level}%; animation-delay:${i * 0.07}s`}
          >
            <div class="skill-card__stripe"></div>
            <div class="skill-card__header">
              <span class="skill-card__icon">{skill.icon}</span>
              <span class="skill-card__rarity">{cfg.label}</span>
            </div>
            <div class="skill-card__name">{skill.name}</div>
            <div class="skill-card__bar-wrap">
              <div class="skill-card__bar"></div>
            </div>
            <div class="skill-card__percent">{skill.level}%</div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ═════════════════════════════ PROJECTS ═══════════════════════════════ -->
  <div class="divider"></div>
  <section id="projects" class="section projects">
    <div class="section__header reveal">
      <p class="section-eyebrow">// REGISTRO DE OPERACIONES</p>
      <h2 class="section-title">MISSION <span>LOG</span></h2>
    </div>

    <div class="projects__grid">
      {projects.map((proj, i) => (
        <article
          class="proj-card reveal"
          style={`animation-delay:${i * 0.12}s`}
        >
          <div class="proj-card__top">
            <span class="proj-card__id">#{proj.id}</span>
            <span class={`proj-card__status proj-card__status--${proj.status.replace(' ', '-').toLowerCase()}`}>
              {proj.status}
            </span>
          </div>
          <h3 class="proj-card__name">{proj.name}</h3>
          <p class="proj-card__desc">{proj.desc}</p>
          <div class="proj-card__tags">
            {proj.tags.map(tag => (
              <span class="proj-card__tag">{tag}</span>
            ))}
          </div>
          <div class="proj-card__footer">
            <span class="proj-card__xp">+{proj.xp.toLocaleString()} XP</span>
            <a href="#contact" class="proj-card__btn">INSPECT →</a>
          </div>
          <div class="proj-card__corner" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════ CONTACT ═══════════════════════════════ -->
  <div class="divider divider--flip"></div>
  <section id="contact" class="section contact">
    <div class="section__header reveal">
      <p class="section-eyebrow">// CANAL DE COMUNICACIÓN</p>
      <h2 class="section-title">DEPLOY <span>MESSAGE</span></h2>
    </div>

    <div class="contact__wrapper reveal">
      <!-- Info panel -->
      <div class="contact__info">
        <div class="contact__info-item">
          <span class="contact__info-label">EMAIL</span>
          <span class="contact__info-value">tu@email.com</span>
        </div>
        <div class="contact__info-item">
          <span class="contact__info-label">GITHUB</span>
          <span class="contact__info-value">github.com/tu_usuario</span>
        </div>
        <div class="contact__info-item">
          <span class="contact__info-label">LINKEDIN</span>
          <span class="contact__info-value">linkedin.com/in/tu_perfil</span>
        </div>
        <div class="contact__info-item">
          <span class="contact__info-label">STATUS</span>
          <span class="contact__info-value contact__info-available">
            <span class="dot-pulse"></span>DISPONIBLE PARA PROYECTOS
          </span>
        </div>
      </div>

      <!-- Form -->
      <form class="contact__form" id="contactForm">
        <div class="fn-field">
          <label class="fn-field__label" for="name">// IDENTIFICADOR</label>
          <input class="fn-field__input" type="text" id="name" name="name" placeholder="Tu nombre" required />
        </div>
        <div class="fn-field">
          <label class="fn-field__label" for="email">// EMAIL</label>
          <input class="fn-field__input" type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>
        <div class="fn-field">
          <label class="fn-field__label" for="message">// MENSAJE</label>
          <textarea class="fn-field__input fn-field__textarea" id="message" name="message" placeholder="Describe tu misión..." rows="5" required></textarea>
        </div>
        <button type="submit" class="btn-fn btn-fn-primary contact__submit">
          <span class="contact__submit-icon">▶</span> TRANSMITIR MENSAJE
        </button>
      </form>
    </div>
  </section>

  <!-- ═══════════════════════════════ FOOTER ═══════════════════════════════ -->
  <footer class="fn-footer">
    <div class="fn-footer__left">
      <span>© 2026 TU NOMBRE</span>
      <span class="fn-footer__sep">|</span>
      <span>BUILT WITH ASTRO + ☕</span>
    </div>
    <div class="fn-footer__right">
      <span class="fn-footer__mono">v1.0.0-SEASON01</span>
    </div>
  </footer>

</PortfolioLayout>

<!-- ═══════════════════════════════ STYLES ═══════════════════════════════ -->
<style>
  /* ── NAVBAR ─────────────────────────────────────────────────────────── */
  .fn-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2.5rem;
    background: rgba(7, 11, 20, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--fn-border);
  }

  .fn-nav__logo {
    font-family: var(--fn-font-display);
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    color: var(--fn-blue);
  }
  .fn-nav__logo-bracket { color: var(--fn-gold); }

  .fn-nav__links {
    list-style: none;
    display: flex;
    gap: 2rem;
  }
  .fn-nav__links a {
    font-family: var(--fn-font-display);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    color: var(--fn-gray);
    transition: color 0.2s;
  }
  .fn-nav__links a:hover { color: var(--fn-blue); text-shadow: var(--fn-glow-blue); }

  .fn-nav__status {
    font-family: var(--fn-font-mono);
    font-size: 0.75rem;
    color: var(--fn-green);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    letter-spacing: 0.1em;
  }
  .fn-nav__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--fn-green);
    box-shadow: 0 0 8px var(--fn-green);
    animation: pulse-glow 2s infinite;
  }

  /* ── HERO ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 60px;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(rgba(0,200,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,200,255,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  }

  /* HUD corners */
  .hud {
    position: absolute;
    z-index: 5;
    font-family: var(--fn-font-mono);
    padding: 0.6rem 1rem;
    border: 1px solid var(--fn-border);
    background: rgba(7,11,20,0.7);
    backdrop-filter: blur(6px);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  }
  .hud--tl { top: 80px;  left: 2rem; }
  .hud--tr { top: 80px;  right: 2rem; }
  .hud--bl { bottom: 60px; left: 2rem; }
  .hud--br { bottom: 60px; right: 2rem; }

  .hud__label {
    font-size: 0.6rem;
    color: var(--fn-gray);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hud__value {
    font-size: 0.85rem;
    color: var(--fn-blue);
    font-weight: bold;
    letter-spacing: 0.1em;
  }
  .hud__xp { color: var(--fn-gold); text-shadow: 0 0 8px rgba(245,166,35,0.5); }

  /* Hero content */
  .hero__content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 900px;
    padding: 2rem;
  }

  .hero__eyebrow {
    font-family: var(--fn-font-mono);
    font-size: 0.85rem;
    color: var(--fn-blue);
    letter-spacing: 0.25em;
    margin-bottom: 1.5rem;
    animation: flicker 8s infinite;
  }

  .hero__title {
    font-family: var(--fn-font-display);
    line-height: 1;
    margin-bottom: 1.5rem;
  }
  .hero__title-line {
    display: block;
    font-size: clamp(3.5rem, 12vw, 10rem);
    letter-spacing: 0.05em;
    color: var(--fn-white);
  }
  .hero__title-line--2 em {
    font-style: normal;
    color: var(--fn-blue);
    text-shadow: var(--fn-glow-blue);
    -webkit-text-stroke: 1px var(--fn-blue);
  }

  .hero__subtitle {
    font-size: 1.1rem;
    color: var(--fn-gray);
    max-width: 540px;
    margin: 0 auto 2rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .hero__cursor {
    color: var(--fn-blue);
    animation: blink 1s infinite;
  }

  .hero__level {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2rem;
  }
  .hero__level-label {
    font-family: var(--fn-font-mono);
    font-size: 0.7rem;
    color: var(--fn-gold);
    letter-spacing: 0.1em;
  }
  .hero__level-bar {
    width: 280px;
    height: 6px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(245,166,35,0.3);
    clip-path: polygon(4px 0%, 100% 0%, calc(100% - 4px) 100%, 0% 100%);
    overflow: hidden;
  }
  .hero__level-fill {
    height: 100%;
    width: 90%;
    background: linear-gradient(90deg, var(--fn-gold-dark), var(--fn-gold));
    box-shadow: 0 0 8px var(--fn-gold);
    animation: slide-right 1.5s ease-out 0.5s both;
    --target-width: 90%;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--fn-font-mono);
    font-size: 0.65rem;
    color: var(--fn-gray);
    letter-spacing: 0.2em;
    animation: float 2s ease-in-out infinite;
  }
  .scroll-indicator__line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--fn-blue), transparent);
  }

  /* ── SECTION BASE ────────────────────────────────────────────────────── */
  .section {
    padding: 6rem 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section__header {
    margin-bottom: 3.5rem;
  }

  /* ── SKILLS ──────────────────────────────────────────────────────────── */
  .skills {
    background: none;
  }
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .skill-card {
    position: relative;
    background: linear-gradient(135deg, rgba(13,21,38,0.95), rgba(7,11,20,0.95));
    border: 1px solid var(--rarity-color, var(--fn-border));
    padding: 1.25rem 1rem 1rem;
    clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%);
    box-shadow: 0 0 12px var(--rarity-glow, transparent),
                inset 0 0 20px rgba(0,0,0,0.3);
    transition: transform 0.25s, box-shadow 0.25s;
    overflow: hidden;
  }
  .skill-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 0 24px var(--rarity-glow, transparent),
                inset 0 0 20px rgba(0,0,0,0.3);
  }

  .skill-card__stripe {
    position: absolute;
    top: 0; left: 0;
    width: 3px;
    height: 100%;
    background: var(--rarity-color);
    box-shadow: 0 0 8px var(--rarity-glow);
  }

  .skill-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-left: 0.5rem;
  }
  .skill-card__icon { font-size: 1.3rem; }
  .skill-card__rarity {
    font-family: var(--fn-font-mono);
    font-size: 0.6rem;
    color: var(--rarity-color);
    letter-spacing: 0.1em;
    border: 1px solid var(--rarity-color);
    padding: 0.1rem 0.4rem;
    clip-path: polygon(4px 0,100% 0,calc(100% - 4px) 100%,0 100%);
    background: rgba(0,0,0,0.3);
  }
  .skill-card__name {
    font-family: var(--fn-font-display);
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    color: var(--fn-white);
    padding-left: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .skill-card__bar-wrap {
    height: 5px;
    background: rgba(255,255,255,0.07);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 0.4rem;
    margin-left: 0.5rem;
  }
  .skill-card__bar {
    height: 100%;
    width: 0;
    background: var(--rarity-color);
    box-shadow: 0 0 6px var(--rarity-glow);
    border-radius: 2px;
    transition: width 1.2s cubic-bezier(.17,.67,.35,1) 0.3s;
  }
  .skill-card.visible .skill-card__bar {
    width: var(--skill-level);
  }
  .skill-card__percent {
    font-family: var(--fn-font-mono);
    font-size: 0.7rem;
    color: var(--fn-gray);
    padding-left: 0.5rem;
    text-align: right;
  }

  /* ── DIVIDER ─────────────────────────────────────────────────────────── */
  .divider {
    width: 100%;
    height: 70px;
    background: var(--fn-bg2);
    clip-path: polygon(0 0, 100% 60%, 100% 100%, 0 100%);
    margin: 0;
  }
  .divider--flip {
    clip-path: polygon(0 40%, 100% 0%, 100% 100%, 0 100%);
  }

  /* ── PROJECTS ────────────────────────────────────────────────────────── */
  .projects {
    background: none;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .proj-card {
    position: relative;
    background: linear-gradient(135deg, rgba(13,21,38,0.98), rgba(7,11,20,0.98));
    border: 1px solid var(--fn-border);
    padding: 1.75rem;
    clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.25s;
    overflow: hidden;
  }
  .proj-card:hover {
    border-color: var(--fn-blue);
    box-shadow: var(--fn-glow-blue);
    transform: translateY(-4px);
  }

  .proj-card__corner {
    position: absolute;
    top: 0; right: 0;
    width: 24px; height: 24px;
    background: var(--fn-blue);
    clip-path: polygon(100% 0, 0 0, 100% 100%);
    opacity: 0.7;
  }

  .proj-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .proj-card__id {
    font-family: var(--fn-font-mono);
    font-size: 0.75rem;
    color: var(--fn-blue);
    letter-spacing: 0.1em;
  }

  .proj-card__status {
    font-family: var(--fn-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.6rem;
    clip-path: polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%);
  }
  .proj-card__status--deployed   { background: rgba(0,230,118,0.15); color: var(--fn-green); border: 1px solid var(--fn-green); }
  .proj-card__status--completed  { background: rgba(0,200,255,0.15); color: var(--fn-blue);  border: 1px solid var(--fn-blue);  }
  .proj-card__status--in-progress{ background: rgba(245,166,35,0.15); color: var(--fn-gold); border: 1px solid var(--fn-gold);  }

  .proj-card__name {
    font-family: var(--fn-font-display);
    font-size: 1.6rem;
    letter-spacing: 0.05em;
    color: var(--fn-white);
    margin-bottom: 0.5rem;
  }
  .proj-card__desc {
    font-size: 0.9rem;
    color: var(--fn-gray);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    font-weight: 400;
  }
