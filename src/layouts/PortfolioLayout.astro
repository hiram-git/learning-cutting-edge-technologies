---
interface Props {
  title?: string;
}
const { title = 'Portfolio' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Scan lines overlay -->
  <div class="scanlines" aria-hidden="true"></div>
  <!-- Vignette -->
  <div class="vignette" aria-hidden="true"></div>
  <slot />
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --fn-bg:        #070b14;
    --fn-bg2:       #0d1526;
    --fn-blue:      #00c8ff;
    --fn-blue-dark: #0088bb;
    --fn-gold:      #f5a623;
    --fn-gold-dark: #c47f10;
    --fn-purple:    #9b59ff;
    --fn-green:     #00e676;
    --fn-gray:      #8899aa;
    --fn-white:     #e8f4ff;
    --fn-border:    rgba(0, 200, 255, 0.25);
    --fn-glow-blue: 0 0 12px rgba(0,200,255,0.7), 0 0 30px rgba(0,200,255,0.3);
    --fn-glow-gold: 0 0 12px rgba(245,166,35,0.7), 0 0 30px rgba(245,166,35,0.3);
    --fn-glow-purple: 0 0 12px rgba(155,89,255,0.7), 0 0 30px rgba(155,89,255,0.3);
    --fn-font-display: 'Bebas Neue', sans-serif;
    --fn-font-body:    'Rajdhani', sans-serif;
    --fn-font-mono:    'Share Tech Mono', monospace;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--fn-font-body);
    background: var(--fn-bg);
    color: var(--fn-white);
    overflow-x: hidden;
    position: relative;
  }

  a { text-decoration: none; color: inherit; }

  /* Scan lines overlay */
  .scanlines {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.05) 2px,
      rgba(0,0,0,0.05) 4px
    );
  }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.6) 100%);
  }

  /* Section titles */
  .section-eyebrow {
    font-family: var(--fn-font-mono);
    font-size: 0.75rem;
    color: var(--fn-blue);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--fn-font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--fn-white);
  }

  .section-title span {
    color: var(--fn-blue);
  }

  /* Diagonal divider */
  .divider {
    width: 100%;
    height: 60px;
    clip-path: polygon(0 0, 100% 60%, 100% 100%, 0 100%);
    background: var(--fn-bg2);
    margin-top: -1px;
  }

  /* Glow button */
  .btn-fn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    font-family: var(--fn-font-display);
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    border: none;
    cursor: pointer;
    position: relative;
    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
    transition: all 0.2s;
  }

  .btn-fn-primary {
    background: var(--fn-blue);
    color: var(--fn-bg);
  }
  .btn-fn-primary:hover {
    box-shadow: var(--fn-glow-blue);
    transform: translateY(-2px);
  }

  .btn-fn-secondary {
    background: transparent;
    color: var(--fn-blue);
    border: 1.5px solid var(--fn-blue);
    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
  }
  .btn-fn-secondary:hover {
    background: rgba(0,200,255,0.1);
    box-shadow: var(--fn-glow-blue);
    transform: translateY(-2px);
  }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 8px rgba(0,200,255,0.4); }
    50%       { box-shadow: 0 0 20px rgba(0,200,255,0.9), 0 0 40px rgba(0,200,255,0.4); }
  }

  @keyframes flicker {
    0%, 95%, 100% { opacity: 1; }
    96%            { opacity: 0.7; }
    97%            { opacity: 1; }
    98%            { opacity: 0.5; }
    99%            { opacity: 1; }
  }

  @keyframes slide-right {
    from { width: 0; }
    to   { width: var(--target-width, 100%); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
